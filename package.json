{
  "author": "Andreas Flack",
  "name": "scorekeeper",
  "version": "0.0.11",
  "private": true,
  "homepage": "https://flack.github.io/scorekeeper",
  "bugs": "https://github.com/flack/scorekeeper/issues",
  "repository": {
    "type": "git",
    "url": "git@github.com:flack/scorekeeper.git"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "coverage": "ng test --watch=false --coverage",
    "deploy": "ng build && gh-pages --dist dist --nojekyll",
    "release": "npm version -m \"release v%s\"",
    "postversion": "git push --follow-tags"
  },
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/forms": "^21.2.26",
    "@angular/platform-browser": "^21.2.26",
    "@angular/router": "^21.2.26",
    "@angular/service-worker": "^21.2.26",
    "bootstrap": "^5.3.8",
    "font-awesome": "^4.7.0",
    "moment": "^2.31.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.26",
    "@vitest/coverage-v8": "^4.1.12",
    "gh-pages": "^6.3.0",
    "jsdom": "^28.1.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
